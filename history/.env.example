# ===== fal.ai (mức 3) — 1 key cho cả ảnh và ảnh → video =====
# Tạo key: https://fal.ai/dashboard/keys · nạp tiền: https://fal.ai/dashboard/billing
FAL_KEY=
# Nano Banana (Google) ~$0.04/ảnh, bám prompt tốt
FAL_IMAGE_MODEL=fal-ai/nano-banana
# Biến ảnh thành clip AI 5s: fal | none (none = hiệu ứng zoom/pan miễn phí)
ANIMATE=fal
# Kling 2.6 Pro ~$0.07/giây (tắt audio) → ~$0.35/cảnh
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video
FAL_VIDEO_IMAGE_FIELD=start_image_url
# Chỉ để ước tính chi phí in ra màn hình
FAL_VIDEO_PRICE_PER_SEC=0.07
# Số clip tạo song song
FAL_CONCURRENCY=3

# ===== NGUỒN ẢNH =====
# fal          : dùng FAL_IMAGE_MODEL ở trên (khuyên dùng)
# pollinations : miễn phí, không cần key — chất lượng nháp (576px, tự cắt watermark)
# openai       : cần OPENAI_API_KEY (trả phí theo ảnh)
# gemini       : cần GEMINI_API_KEY (Google AI Studio)
# manual       : tự tạo ảnh theo images/prompts.txt rồi lưu thành images/s001.jpg|png ...
IMAGE_PROVIDER=fal

POLLINATIONS_MODEL=flux
# Token từ auth.pollinations.ai (tuỳ chọn) — có token thì không bị watermark
POLLINATIONS_TOKEN=

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high
OPENAI_IMAGE_QUALITY=medium

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ===== GIỌNG ĐỌC (Edge TTS, miễn phí) =====
# vi-VN-NamMinhNeural (nam, trầm — hợp kể chuyện) | vi-VN-HoaiMyNeural (nữ)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+0%

# ===== NHẠC NỀN =====
# auto = chọn 1 file trong assets/music/ (nếu có) | none = không nhạc | hoặc đường dẫn file
MUSIC=auto
# Âm lượng nhạc (tự giảm thêm khi có lời đọc)
MUSIC_VOLUME=0.25

# ===== PHỤ ĐỀ =====
SUB_FONT=Arial
